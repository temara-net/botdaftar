# Riwayat percakapan pengguna bot (privat, jangan ikut ke Git)
data/*.json

# Artefak harness uji lokal
test/mock_*

# Lingkungan & cache Python lokal (di GitHub Actions dibuat ulang dari requirements)
.venv-daftar/
__pycache__/
daftar/__pycache__/
tests/__pycache__/
testserver/__pycache__/

# File konfigurasi lokal berisi token/key asli, bila dibuat terpisah
config.local.php
.env

# State sesi bot versi Actions (memuat ID Telegram pemilik) — repo PUBLIK,
# state hanya boleh di cache privat Actions, tidak pernah di Git
/state/state.json
